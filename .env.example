# Vacío = mismo origen. En desarrollo Vite proxya /api y /media a VITE_API_TARGET.
# En preview sin API real configurada se usa MSW en el navegador.
VITE_API_BASE_URL=

# Solo desarrollo: true para usar la API simulada (Node, puerto 8787). Equivale a `npm run dev:mock`.
VITE_USE_MOCK_API=false

# Puertos de desarrollo (8000 y 5173 suelen estar cogidos por otros proyectos).
VITE_PORT=5180
VITE_API_TARGET=http://127.0.0.1:8010
